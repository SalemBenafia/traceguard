# Copy this file to scripts/.env and fill in real values. Never commit scripts/.env.
# With an atlassian.net URL, use an API token without scopes.
# A token with scopes needs JIRA_BASE_URL=https://api.atlassian.com/ex/jira/<cloudId>
JIRA_BASE_URL=https://<your-site>.atlassian.net
JIRA_EMAIL=<your-atlassian-email>
JIRA_API_TOKEN=<token B>
PROJECT_KEY=SPF
